%% Sizes of the stress scenarios (elock_concurrency_SUITE,
%% elock_multi_node_concurrency_SUITE). The suites merge this map over
%% their own defaults: ct:get_config(concurrency, #{})
{concurrency, #{
  clients => 200,           % clients per scenario
  rounds => 20,             % lock/unlock rounds per client
  terms => 20,              % distinct terms the clients pick from
  hammer_clients => 500,    % single_term_hammer_test
  many_terms => 10000,      % many_terms_test
  max_timeout => 50,        % ms, timeouts_under_load_test
  deadlock_rounds => 20,    % cap of the rounds of the deadlock storms
  % elock_multi_node_concurrency_SUITE (rounds, terms, max_timeout
  % and deadlock_rounds above apply there as well)
  clients_per_node => 50,   % clients on every node of the cluster
  kill_after => 0.25        % node_kill_under_load_test: the share of the rounds done before the node is killed
}}.
