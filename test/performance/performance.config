%% The nodes of the run by role name, the clients run on every one of
%% them. A node is local (a docker container on this host) or a
%% remote host, where it runs in docker as well, reached over ssh:
%%
%%   node1 => #{
%%     host => "host1.example",
%%     node => "node1@host1.example",
%%     user => "user",
%%     password => "password"
%%   }
{nodes, #{
  node1 => local
  ,node2 => local
%%  ,node3 => local
}}.

%% One fixed workload. Complete settings are required; there are no defaults.
%% Every path replays the same per-client seeded plans. The simulated write
%% cost is paid once at commit for each update/write; reads happen under lock.
{performance, #{
  clients_per_node => 10000,
  transactions_per_client => 10,
  objects_pool_size => 50000000,
  transaction => #{
    read => 0,
    update => 10,
    write => 0
  },
  read_ms => 1,
  write_ms => 1,
  timeout => undefined,       % positive milliseconds or undefined; ignored by Mnesia
  restart_ms => 0,    % after failed elock/global attempts; ignored by Mnesia
  think_ms => 0,      % between completed transactions, after releasing locks
  seed => 12345,
  deadlocks =>  true,   % false: sort by key; true: shuffle operations
  paths => [elock, mnesia],
  % global requires read = 0, sorted order, and at most this many held locks:
  % node_count * clients_per_node * (read + update + write)
  global_max_locks => 1000
}}.

{env_settings, #{
  ecall_batch_size => 1000,
  distribution_busy_limit_kib => 1024
}}.
