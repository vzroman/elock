%% The nodes of the run by role name, the clients run on every one of
%% them. A node is local (a docker container on this host) or a
%% remote host, where it runs in docker as well, reached over ssh:
%%
%%   node1 => #{
%%     host => "host1.example",
%%     node => "node1@host1.example",
%%     user => "user",
%%     password => "password"
%%   }
{nodes, #{
  node1 => local
  ,node2 => local
%%  ,node3 => local
}}.

%% The points of performance_transaction_SUITE, merged over its own
%% defaults: every combination of the lists is a point. The nodes,
%% transactions_per_client, write_ms and deadlocks are fixed per run,
%% the lists nest from the outermost to the innermost in this order
{performance, #{
  transactions_per_client => 100,             % transactions of a client
  write_ms => 10,                              % the imitated database write
  deadlocks => true,                          % false - the locks are taken in the sorted order, true - in a random order
  clients_per_node => [
    1000
%%    ,10000
%%    ,100000
  ],  % clients on every node of nodes
  locks_per_transaction => [
%%    1,
    10
%%    ,100
%%    ,1000
  ], % Nz
  intersect_percents => [
%%    0
%%    ,5
%%    10
    50
%%    ,100
  ],      % P: the share of the locks taken from the shared pool
  exclusive_percents => [
%%    0
%%    ,20
    50
%%    100
  ],      % E: the share of the exclusive locks
  % The paths, run back to back at every point: comment out what is not needed
  paths => [
    elock
    ,mnesia
    %,global
  ],
  % global skips the points where its clients hold more locks at once:
  % size = nodes * clients_per_node * locks_per_transaction. On every lock
  % and unlock global copies the map of all the lock monitors of the node,
  % so a global point takes about transactions_per_client * size^2 * 0.08 us:
  % with 100 transactions per client 8 s at size 1000, 800 s at size 10000
  global_max_locks => 1000
}}.

{env_settings, #{
  ecall_batch_size => 1000,
  distribution_busy_limit_kib => 1024
}}.
